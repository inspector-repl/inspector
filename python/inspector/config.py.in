from pathlib import Path
# generated by cmake

# handle build directory
current_file = Path(__file__).resolve()
build_dir = current_file.parent.parent.parent.parent
libpath = build_dir / "@CMAKE_SHARED_LIBRARY_PREFIX@"

if libpath.exists():
    # Development mode - use relative paths
    LIBRARY_PATH = str(libpath)
    # Go up from build directory to find include directory
    INCLUDE_PATH = str(build_dir.parent / "include")
else:
    # Installed mode - use absolute paths
    LIBRARY_PATH = "@CMAKE_INSTALL_PREFIX@/@CMAKE_SHARED_LIBRARY_PREFIX@"
    INCLUDE_PATH = "@INSPECTOR_INCLUDE_DIR@"
