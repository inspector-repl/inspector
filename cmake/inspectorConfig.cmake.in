@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/inspectorTargets.cmake")

set_and_check(INSPECTOR_BINDIR "@PACKAGE_CMAKE_INSTALL_BINDIR@")
find_program(INSPECTOR_EXECUTABLE inspector HINTS "${INSPECTOR_BINDIR}" REQUIRED)

# Instrument a target: every C++ compile runs through `inspector wrap`, which
# generates the per-callsite headers that `#include INSPECTOR` expands to.
function(inspector_enable target)
  set(_dir "${CMAKE_CURRENT_BINARY_DIR}/.inspector-includes")
  set_property(
    TARGET ${target}
    PROPERTY CXX_COMPILER_LAUNCHER
             ${CMAKE_COMMAND} -E env INSPECTOR_INCLUDE_DIR=${_dir}
             ${INSPECTOR_EXECUTABLE} wrap)
  target_link_libraries(${target} PRIVATE inspector::inspector)
endfunction()
